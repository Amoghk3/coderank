APP_NAME=CodeRank

POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database

DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/db

